# Local dev uses a plain SQLite file (no install needed).
DATABASE_URL="file:./dev.db"

# Production on Vercel: leave DATABASE_URL as-is (it's still used by `prisma migrate`/`db push`
# locally) and instead set these two. When TURSO_DATABASE_URL is present, PrismaService connects
# to Turso (hosted, SQLite-wire compatible) instead of the local file — required because Vercel's
# serverless filesystem is ephemeral. Leave both blank for local dev and for any host with a real
# persistent disk (Render, Railway, a VPS). See README "Deploying to Vercel".
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000

SEED_ADMIN_EMAIL="admin@mehndibydhara.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

CORS_ORIGIN="http://localhost:3000"

SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
